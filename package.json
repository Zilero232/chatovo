{
  "name": "chatovo",
  "version": "1.8.0",
  "private": true,
  "description": "Chatovo — real-time voice rooms for web and desktop. Bun-workspaces monorepo.",
  "keywords": [
    "voice-chat",
    "webrtc",
    "livekit",
    "nextjs",
    "nestjs",
    "tauri",
    "bun"
  ],
  "homepage": "https://chatovo.ru",
  "bugs": {
    "url": "https://github.com/Zilero232/Chatovo/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zilero232/Chatovo.git"
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": "Alexandr Artemev",
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "better-auth": "^1.6.31",
      "date-fns": "^4.4.0",
      "react": "^19.3.0",
      "react-dom": "^19.3.0",
      "remeda": "^2.48.0",
      "ts-pattern": "^5.9.0",
      "typescript": "~6.0.3",
      "zod": "^4.6.1"
    }
  },
  "scripts": {
    "android:build": "bun --filter @chatovo/tauri android:build",
    "android:dev": "bun --filter @chatovo/tauri android:dev",
    "android:init": "bun --filter @chatovo/tauri android:init",
    "build": "bun --filter @chatovo/client build",
    "dev": "bun --filter '@chatovo/server' --filter '@chatovo/client' --parallel dev",
    "dev:client": "bun --filter @chatovo/client dev",
    "dev:full": "docker compose -f docker-compose.dev.yml up -d && bun dev",
    "dev:livekit": "docker compose -f docker-compose.dev.yml up",
    "dev:server": "bun --filter @chatovo/server dev",
    "fix": "bun run lint:fix && bun run format && bun run lint:css:fix",
    "format": "prettier --write .",
    "format:caddy": "mise x -- caddy fmt --overwrite infra/caddy/Caddyfile && mise x -- caddy fmt --overwrite infra/caddy/Caddyfile.dev",
    "format:check": "prettier --check .",
    "format:rust": "cargo fmt --manifest-path apps/tauri/Cargo.toml --all",
    "lint": "eslint .",
    "lint:caddy": "mise x -- caddy fmt infra/caddy/Caddyfile > /dev/null && mise x -- caddy fmt infra/caddy/Caddyfile.dev > /dev/null && mise x -- caddy adapt --config infra/caddy/Caddyfile --adapter caddyfile > /dev/null && mise x -- caddy adapt --config infra/caddy/Caddyfile.dev --adapter caddyfile > /dev/null",
    "lint:css": "stylelint \"apps/client/**/*.scss\"",
    "lint:css:fix": "stylelint \"apps/client/**/*.scss\" --fix",
    "lint:fix": "eslint . --fix",
    "lint:rust": "cargo clippy --manifest-path apps/tauri/Cargo.toml --all-targets -- -D warnings",
    "prepare": "husky",
    "tauri": "bun --filter @chatovo/tauri tauri",
    "tauri:build": "bun --filter @chatovo/tauri build",
    "tauri:dev": "bun --filter '@chatovo/server' --filter '@chatovo/tauri' --parallel dev",
    "tauri:icon": "bun --filter @chatovo/tauri icon",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:watch": "vitest",
    "typecheck": "bun --filter @chatovo/schemas typecheck && bun --filter @chatovo/server typecheck && bun --filter @chatovo/client typecheck",
    "verify": "bun run typecheck && bun run lint && bun run format:check && bun run lint:css"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/package.json": [
      "sort-package-json"
    ],
    "*.{json,md,yml,yaml}": "prettier --write",
    "infra/caddy/Caddyfile*": "mise x -- caddy fmt --overwrite",
    "apps/client/**/*.scss": [
      "stylelint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@types/react-dom": "^19.3.0",
    "better-auth": "^1.6.31"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@playwright/test": "^1.63.0",
    "@siberiacancode/eslint": "^2.18.1",
    "@siberiacancode/prettier": "^1.9.0",
    "@siberiacancode/stylelint": "^1.2.0",
    "@siberiacancode/tsconfig": "^1.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.10.0",
    "fkill-cli": "^9.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.6",
    "sort-package-json": "^4.0.0",
    "stylelint": "17.15.0",
    "stylelint-config-idiomatic-order": "^10.0.0",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-order": "8.1.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  }
}
