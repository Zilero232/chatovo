model User {
  id            String  @id
  name          String
  email         String  @unique
  friendTag     String  @unique
  emailVerified Boolean @default(false)
  image         String?

  role      String  @default("user")
  verified  Boolean @default(false)
  developer Boolean @default(false)

  banned     Boolean?  @default(false)
  banReason  String?   @map("ban_reason")
  banExpires DateTime? @map("ban_expires") @db.Timestamptz(3)

  bannedAt   DateTime? @map("banned_at") @db.Timestamptz(3)
  bannedById String?   @map("banned_by_id")

  sessions Session[]
  accounts Account[]
  profile  Profile?
  rooms    Room[]
  messages Message[]

  dmRoomsA Room[]    @relation("DmUserA")
  dmRoomsB Room[]    @relation("DmUserB")
  
  pushDevices          PushDevice[]
  
  friendshipsRequested Friendship[] @relation("FriendshipRequester")
  friendshipsReceived  Friendship[] @relation("FriendshipAddressee")

  blocksIssued   UserBlock[] @relation("UserBlocker")
  blocksReceived UserBlock[] @relation("UserBlocked")

  roomBans       RoomBan[] @relation("RoomBanned")
  roomBansIssued RoomBan[] @relation("RoomBanIssuer")

  abuseReportsFiled   AbuseReport[] @relation("AbuseReporter")
  abuseReportsHandled AbuseReport[] @relation("AbuseHandler")

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([createdAt(sort: Desc)])
  @@index([banned])
  @@map("user")
}

model Session {
  id        String   @id
  token     String   @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime @db.Timestamptz(3)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  impersonatedBy String? @map("impersonated_by")

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  issuer                String    @default("local:credential")
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@map("verification")
}
