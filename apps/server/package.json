{
  "name": "@chatovo/server",
  "version": "0.0.0",
  "private": true,
  "description": "Chatovo API — NestJS on Bun with Prisma, better-auth and LiveKit.",
  "homepage": "https://chatovo.ru",
  "bugs": {
    "url": "https://github.com/Zilero232/Chatovo/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zilero232/Chatovo.git",
    "directory": "apps/server"
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": "Alexandr Artemev",
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "db:baseline": "prisma migrate resolve --applied 20260901000000_init || exit 0",
    "db:deploy": "prisma migrate deploy",
    "db:fresh": "prisma migrate reset --force --skip-seed && prisma generate",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:push": "prisma db push && prisma generate",
    "db:push:force": "prisma db push --accept-data-loss && prisma generate",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "predev": "fkill :4000 --force --silent",
    "dev": "bun --hot --cwd ../.. --env-file .env apps/server/src/main.ts",
    "postinstall": "prisma generate",
    "start": "bun src/main.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cacheable/utils": "^2.5.0",
    "@chatovo/schemas": "workspace:*",
    "@grammyjs/parse-mode": "^2.3.0",
    "@nestjs/cache-manager": "3.1.3",
    "@nestjs/common": "11.2.3",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.3",
    "@nestjs/event-emitter": "3.1.0",
    "@nestjs/platform-express": "11.2.3",
    "@nestjs/platform-ws": "11.2.3",
    "@nestjs/schedule": "12.0.2",
    "@nestjs/serve-static": "5.0.5",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/terminus": "11.1.1",
    "@nestjs/throttler": "6.5.0",
    "@nestjs/websockets": "11.2.3",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@react-email/render": "^2.1.0",
    "@thallesp/nestjs-better-auth": "2.8.0",
    "better-auth": "catalog:",
    "cache-manager": "7.2.9",
    "cacheable": "^2.5.0",
    "content-type": "^3.1.1",
    "date-fns": "catalog:",
    "express": "5.2.1",
    "firebase-admin": "^14.3.0",
    "grammy": "^1.46.0",
    "helmet": "8.3.0",
    "html-encoding-sniffer": "^7.0.0",
    "iconv-lite": "^0.7.3",
    "ipaddr.js": "^2.5.0",
    "keyv": "^5.6.0",
    "livekit-server-sdk": "^2.19.0",
    "mime-types": "^3.0.2",
    "nestjs-pino": "4.6.1",
    "nestjs-zod": "5.5.0",
    "nodemailer": "^9.1.1",
    "open-graph-scraper": "^6.12.0",
    "pg": "^8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-email": "^6.9.5",
    "reflect-metadata": "0.2.2",
    "remeda": "catalog:",
    "rxjs": "7.8.2",
    "sharp": "^0.35.5",
    "ts-pattern": "catalog:",
    "ws": "8.21.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@chatovo/tsconfig": "workspace:*",
    "@types/bun": "^1.4.2",
    "@types/content-type": "^2.0.0",
    "@types/express": "^5.0.6",
    "@types/html-encoding-sniffer": "^3.0.2",
    "@types/mime-types": "^3.0.1",
    "@types/multer": "^2.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/ws": "^8.18.1",
    "dotenv": "catalog:",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.10.0",
    "typescript": "catalog:"
  }
}
