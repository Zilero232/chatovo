{
  "extends": "@chatovo/tsconfig/react.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "vite-env.d.ts",
    "messages.d.ts",
    "router.d.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.setup.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "entities/**/*.ts",
    "entities/**/*.tsx",
    "features/**/*.ts",
    "features/**/*.tsx",
    "views/**/*.ts",
    "views/**/*.tsx",
    "shared/**/*.ts",
    "shared/**/*.tsx",
    "widgets/**/*.ts",
    "widgets/**/*.tsx"
  ],
  "exclude": ["node_modules", "dist"]
}
