# Chatovo — Caddy config (runs on the VPS).
#
# chatovo.ru is the public website: a Next.js server in the `landing` container.
# app.chatovo.ru is the web app: the static Vite SPA build baked into this image.
# Each host sends the other's paths across with a permanent redirect, so old
# links and bookmarks keep working.
#
# Needs DNS A-records for chatovo.ru, www, app, api and livekit pointing here,
# plus ports 80 and 443 open. TLS certificates are issued automatically.

(static_client) {
	root * /srv/www

	# Vite fingerprints everything it emits under /assets.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	encode zstd gzip
}

# A single-page app: a real file wins, every other path gets index.html and the
# client router renders the route (or its not-found page).
(static_routing) {
	try_files {path} /index.html
	file_server
}

www.chatovo.ru {
	redir https://chatovo.ru{uri} permanent
}

livekit.chatovo.ru {
	# LiveKit runs with network_mode: host, so from this bridge-networked
	# container it is reachable via host-gateway (see docker-compose.yml).
	#
	# The WSS signalling connection is exempt from CORS, but the client also
	# fetches /rtc/v1/validate, which is not. Allow-Origin must carry a single
	# value, so the request Origin is matched and echoed back.

	@cors_app header Origin https://app.chatovo.ru
	@cors_tauri header Origin tauri://localhost
	@cors_tauri_win header Origin http://tauri.localhost

	header @cors_app Access-Control-Allow-Origin "https://app.chatovo.ru"
	header @cors_tauri Access-Control-Allow-Origin "tauri://localhost"
	header @cors_tauri_win Access-Control-Allow-Origin "http://tauri.localhost"

	@cors_preflight method OPTIONS
	handle @cors_preflight {
		header Access-Control-Allow-Methods "GET, POST, OPTIONS"
		header Access-Control-Allow-Headers "Authorization, Content-Type"
		header Access-Control-Max-Age "3600"
		respond 204
	}

	reverse_proxy host.docker.internal:7880 {
		# LiveKit emits its own `Access-Control-Allow-Origin: *`; left in place
		# the browser sees the header twice and drops the user from the room.
		header_down -Access-Control-Allow-Origin
	}
}

api.chatovo.ru {
	reverse_proxy server:4000
}

app.chatovo.ru {
	import static_client

	# Messenger and social crawlers don't run JS, so the room page would unfurl
	# as the generic site card. They get server-rendered Open Graph tags
	# with the room name and live headcount instead; people still get the app.
	@link_preview_bot {
		path /room
		header_regexp User-Agent (?i)(telegrambot|discordbot|twitterbot|facebookexternalhit|vkshare|whatsapp|slackbot|linkedinbot|skypeuripreview|viber|mattermost|iframely|redditbot)
	}
	handle @link_preview_bot {
		rewrite * /link-preview/room?{query}
		reverse_proxy server:4000
	}

	# Nothing on the app host belongs in an index; the public site owns SEO.
	handle /robots.txt {
		header Content-Type "text/plain; charset=utf-8"
		respond <<ROBOTS
			User-agent: Twitterbot
			Allow: /room
			Disallow: /

			User-agent: *
			Disallow: /

			ROBOTS 200
	}

	# Site pages used to be served from this host too.
	@site path /features /download /changelog /about /support /privacy /terms /en /en/*
	redir @site https://chatovo.ru{uri} permanent

	handle {
		import static_routing
	}
}

chatovo.ru {
	encode zstd gzip

	# App pages live on the app host, where the session is.
	@app path /lobby /lobby/* /room /room/* /auth /auth/* /admin /admin/* /account/delete /account/delete/*
	redir @app https://app.chatovo.ru{uri} permanent

	reverse_proxy landing:3000
}
