# Chatovo — one shared .env for the web app, the site and the server.
# Copy to `.env` and fill in. Values differ per environment, names never do.
# Tauri has its own apps/tauri/.env.example; release/deploy secrets live in
# GitHub Actions (each workflow header lists what it needs).

# ============ client ============
# NEXT_PUBLIC_* are baked into the bundle at build time and visible in the
# browser — never put a secret here. Both the web app (Vite, which reads only
# these keys from this file) and the site (Next) use the same names.
#
# API URL per target: local `http://localhost:4000`, production
# `https://api.chatovo.ru`, Android emulator keeps localhost (rewritten to
# 10.0.2.2 at runtime).
NEXT_PUBLIC_API_URL=http://localhost:4000

# Origin of the app host, used for invite links and the site's "open app" button.
# Leave EMPTY locally so those links stay on the current origin; on the VPS set
# it to https://app.chatovo.ru.
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_LIVEKIT_URL=wss://livekit.chatovo.ru

# ============ site ============
# The public website (apps/site) renders on the server. It reads release and
# contributor data from the API over this URL — on the VPS the internal Docker
# address (set in docker-compose.yml, not here). Empty locally: it falls back
# to NEXT_PUBLIC_API_URL. Links into the app use NEXT_PUBLIC_APP_URL
# (http://localhost:3000 when empty).
API_INTERNAL_URL=

# ============ server ============

NODE_ENV=development
PORT=4000

# Allowed web origin(s), comma-separated. The API is on its own subdomain, so
# the browser does send preflights. Tauri origins are always allowed.
# ORDER MATTERS: the first entry is the base for auth callback links, so the
# app host goes first — the public site never receives a sign-in redirect.
#   VPS: https://app.chatovo.ru,https://chatovo.ru · local: http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# The public website; room link previews take their Open Graph image from it.
# Defaults to https://chatovo.ru, so production needs nothing here.
SITE_URL=https://chatovo.ru

# --- Auth (better-auth) ---
# Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Public URL of THIS API server, where /auth/* is mounted.
BETTER_AUTH_URL=http://localhost:4000

# Extra allowedHosts for development only, comma-separated. Needed when testing
# on a physical Android device: `tauri android dev --host <LAN_IP>`.
#   AUTH_DEV_ALLOWED_HOSTS=192.168.1.7:*
AUTH_DEV_ALLOWED_HOSTS=

# --- Email (SMTP) ---
# Powers email verification, change-email and password reset.
#   Yandex/Mail.ru: port 465 + SMTP_SECURE=true · STARTTLS: port 587 + false
#   SMTP_PASSWORD is an app password, not the account password.
#
# Mail reaches inboxes only if EMAIL_FROM equals SMTP_USER (providers reject a
# From you are not logged in as) and SPF/DKIM/DMARC exist for the domain.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@chatovo.ru
SMTP_PASSWORD=your-app-password
EMAIL_FROM=Chatovo <noreply@chatovo.ru>

# Receives bug reports and abuse reports.
SUPPORT_EMAIL=zilero@chatovo.ru

# Dev only: redirect every outgoing email here instead of the real recipient.
# DEV_EMAIL_OVERRIDE=you@example.com

# --- File uploads (local disk, served under /uploads) ---
UPLOADS_DIR=./uploads

# Resized images produced by GET /images (disposable cache, regenerated on demand).
IMAGE_CACHE_DIR=./.image-cache

# Public origin files are served from, used to build absolute URLs in the DB.
PUBLIC_FILES_URL=http://localhost:4000

# --- LiveKit ---
# The key and secret must match the LiveKit side: the Cloud dashboard, the VPS
# livekit.yaml, or livekit.dev.yaml in the repo root for the local SFU.
# Webhooks (the live presence panel) only work when LiveKit can reach this API,
# so a Cloud/VPS SFU cannot drive presence against localhost — use the local
# SFU for that (infra/livekit/README.md).
#   local dev: LIVEKIT_API_KEY=devkey, LIVEKIT_URL=ws://localhost:7880,
#              LIVEKIT_API_SECRET=devsecret_devsecret_devsecret_32
LIVEKIT_API_KEY=API...
LIVEKIT_API_SECRET=...
LIVEKIT_URL=wss://livekit.chatovo.ru

# --- Telegram notifications (optional) ---
# Leave both unset to disable. Create a bot via @BotFather for the token; get
# the chat id by messaging the bot, then reading result[].message.chat.id from
# https://api.telegram.org/bot<token>/getUpdates (negative for groups).
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_CHAT_ID=123456789
#
# Outbound http(s) proxy for api.telegram.org, for hosts that cannot reach the
# Bot API directly. socks5:// is not supported by Bun's fetch. Run it on a node
# that can reach Telegram (e.g. tinyproxy, firewalled to this server's IP).
# TELEGRAM_PROXY_URL=http://proxy-host:8888

# Outbound http(s) proxy for link previews and remote images, for sites the server
# cannot reach directly (e.g. YouTube from RU). Can be the same proxy as above.
# OUTBOUND_PROXY_URL=http://proxy-host:8888

# --- Push (optional) ---
# FCM: stringified service account JSON from Firebase Console → Project
# settings → Service accounts → Generate new private key.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# --- Database (self-hosted Postgres) ---
# POSTGRES_* are read by the postgres container in docker-compose.yml.
POSTGRES_USER=chatovo
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=chatovo

# Used by Prisma and better-auth at runtime. Host is the compose service name
# `postgres` in Docker, `localhost` for local dev. Both URLs are the same for a
# single self-hosted instance.
DATABASE_URL="postgresql://chatovo:replace-with-a-strong-password@postgres:5432/chatovo"
DIRECT_URL="postgresql://chatovo:replace-with-a-strong-password@postgres:5432/chatovo"
