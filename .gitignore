# Repo-wide ignores. Build output and runtime data that belong to one package
# live in that package's own .gitignore:
#   apps/web/.gitignore    — .next/, out/, dist/, next-env.d.ts
#   apps/server/.gitignore    — generated/, dist/, uploads/, .image-cache/
#   apps/tauri/.gitignore     — target/, gen/, icons/
#   packages/schemas/.gitignore — dist/

# Dependencies
node_modules/

# Build caches
*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment — the only env files committed are the `.env.example` templates
.env
.env.*
!.env.example
*.local

# Signing material: Tauri updater minisign keys, Android keystores
# (written by apps/tauri/scripts/android-signing.mjs), certificates
*.key
*.key.pub
*.keystore
keystore.properties
*.pem

# Tests
coverage/
test-results/
e2e/.results/
playwright-report/
playwright/.cache/

# Local tool overrides
mise.local.toml
.claude/settings.local.json

# Superpowers brainstorming artifacts (companion mockups, session state, specs)
.superpowers/
docs/superpowers/

# Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS
.DS_Store
Thumbs.db
desktop.ini
