bunx lint-staged

staged=$(git diff --cached --name-only --diff-filter=ACMR)

staged_has() {
  printf '%s\n' "$staged" | grep -E "$1" > /dev/null
}

# bun --filter takes no git range (there is no pnpm --filter=[HEAD^1] equivalent),
# so work out the touched workspaces here and filter by path.
typecheck_targets=''

# Root configs and the shared packages affect every workspace at once.
if staged_has '^(package\.json|bun\.lock|tsconfig.*\.json)$' || staged_has '^packages/(schemas|config|ui-kit)/'; then
  typecheck_targets='./packages/schemas ./packages/config ./packages/ui-kit ./apps/server ./apps/web ./apps/site'
else
  staged_has '^apps/server/' && typecheck_targets="$typecheck_targets ./apps/server"
  staged_has '^apps/web/' && typecheck_targets="$typecheck_targets ./apps/web"
  staged_has '^apps/site/' && typecheck_targets="$typecheck_targets ./apps/site"
fi

for target in $typecheck_targets; do
  bun --filter "$target" typecheck || exit 1
done

if staged_has '\.rs$|Cargo\.(toml|lock)$'; then
  cargo fmt --manifest-path apps/tauri/Cargo.toml --all --check
  bun run lint:rust
fi
